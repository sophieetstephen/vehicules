[Unit]
Description=Sauvegarde de la base Vehicules

[Service]
Type=oneshot
# Exécuter en tant qu'utilisateur applicatif (pas root) : rclone réécrit son
# fichier de configuration à chaque rafraîchissement du jeton Google ; lancé
# en root, le fichier deviendrait propriété de root et les sauvegardes
# manuelles de l'utilisateur échoueraient ensuite ("permission denied").
User=pi
Group=pi
# Adapter les chemins à l'installation (exemple : Raspberry Pi, déploiement Docker).
WorkingDirectory=/opt/vehicules/app/vehicules
Environment=DB_PATH=/opt/vehicules/app/vehicules/instance/instance/vehicules.db
# Destination chiffree (remote rclone de type crypt, voir le README) : le
# .env n'est jamais envoye vers une destination en clair.
Environment=REMOTE_URI=gdrive-chiffre:sauvegardes
Environment=RCLONE_CONFIG=/home/pi/.config/rclone/rclone.conf
ExecStart=/usr/bin/env bash tools/backup_db.sh
